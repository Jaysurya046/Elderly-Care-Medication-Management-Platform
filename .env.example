# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elder_care?schema=public"

# Redis Queue & Rate Limiting
REDIS_URL="redis://localhost:6379"

# Auth.js / NextAuth Session Secret (min 32 chars)
AUTH_SECRET="elder-care-super-secret-development-key-32chars"

# Application Encryption Key (32-byte hex for AES-256-GCM encryption of TOTP secrets)
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application URL
APP_BASE_URL="http://localhost:3000"

# Email Configuration
EMAIL_PROVIDER="mailpit" # "mailpit" in development | "resend" in production
RESEND_API_KEY=""
EMAIL_FROM="Elder Care <notifications@eldercare.local>"

# Mailpit SMTP (Development)
SMTP_HOST="localhost"
SMTP_PORT="1025"

# Default Timezone for elder profiles
DEFAULT_TIMEZONE="Asia/Kolkata"

# Observability (Optional)
SENTRY_DSN=""

# Feature Flags
FEATURE_AI_ENABLED="false"
